# Local defaults. For Railway set NODE_ENV=production and a PostgreSQL DATABASE_URL.
NODE_ENV=development
APP_ORIGIN=http://localhost:5180
PORT=3080
DATABASE_URL=pglite://.local/chancery-db
# Use a PostgreSQL migration/admin role if separate from the runtime role.
# MIGRATION_DATABASE_URL=postgresql://...

# Server-side only. Do not expose these through VITE_ or frontend code.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=
# Set exclusive only when completion_tokens excludes separately reported reasoning.
PROVIDER_REASONING_MODE=inclusive
PROVIDER_FEE_BPS=550
# Optional comma-separated PROVIDER model IDs. Empty permits priced chat models.
MODEL_ALLOWLIST=
# Populate only after verifying PROVIDER account routing and upstream retention terms.
ZERO_RETENTION_MODELS=

# Robinhood Chain MAINNET, chain ID 4663.
RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHANCERY_REGISTRY_ADDRESS=
# Fund this dedicated operator wallet only for gas. It never receives Safe owner keys.
SETTLER_PRIVATE_KEY=
# Wire the actual token contract after launch; no fake token address is bundled.
# The legacy CHNC_TOKEN_ADDRESS setting remains supported.
CCRY_TOKEN_ADDRESS=

# Generate these once with npm run secrets:generate; persist across deploys.
STORAGE_ENCRYPTION_KEY=
RECEIPT_SIGNING_KEY=

# Default: all five updates off. IDs: rooms,clerks,safe_drafts,minutes,token_benefits
# safe_drafts requires clerks; token_benefits requires CCRY_TOKEN_ADDRESS.
RELEASED_UPDATES=
# Use none only for an HTTPS frontend on a different site. Same-site proxying is preferred.
COOKIE_SAME_SITE=lax
