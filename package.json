{
  "name": "chancery",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,app \"npm:dev:api\" \"npm:dev:app\"",
    "start": "node --import tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck:backend && npm run typecheck:web && npm run contracts:compile && npm run build:web",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "npm run typecheck:backend && npm run typecheck:web",
    "db:migrate": "node --import tsx --env-file-if-exists=.env server/migrate.ts",
    "worker": "node --import tsx --env-file-if-exists=.env server/worker.ts",
    "contracts:compile": "node --import tsx scripts/compile-contracts.ts",
    "dev:api": "node --import tsx --env-file-if-exists=.env --watch server/index.ts",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "secrets:generate": "node --import tsx scripts/generate-secrets.ts",
    "deployment:payload": "node --import tsx scripts/deployment-payload.ts",
    "billing:reconcile": "node --import tsx --env-file-if-exists=.env scripts/reconcile-billing.ts",
    "package:backend": "node --import tsx scripts/package-backend.ts",
    "dev:app": "vite",
    "build:web": "vite build && node --import tsx scripts/build-site.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "package:app": "node --import tsx scripts/package-backend.ts",
    "test:ui": "node --import tsx tests/ui-server.ts",
    "deployment:verify": "node --import tsx scripts/verify-deployment.ts",
    "test:coverage": "c8 --all --include=\"server/**/*.ts\" --include=\"shared/**/*.ts\" --include=\"packages/client/**/*.ts\" --exclude=\"**/*.d.ts\" --exclude=\"server/index.ts\" --exclude=\"server/worker.ts\" --exclude=\"server/migrate.ts\" --reporter=text --reporter=json-summary node --import tsx --test tests/*.test.ts",
    "mcp:bridge": "node --import tsx scripts/mcp-bridge.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.20.6",
    "viem": "2.56.9",
    "zod": "4.6.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@scure/bip39": "1.6.0"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "c8": "10.1.3",
    "concurrently": "10.0.6",
    "prettier": "3.6.2",
    "railway": "3.16.0",
    "solc": "0.8.38",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "packageManager": "npm@11.19.1"
}
